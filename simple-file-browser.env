# simple-file-browser configuration
#
# Copied to /etc/simple-file-browser.env by install.sh; edit it there to override
# the defaults baked into the systemd unit. Restart the service after
# editing:  systemctl restart simple-file-browser.service

# TCP port to listen on.
PORT=8080

# Root directory to serve. Everything under this path is exposed over
# HTTP with browse / download / upload / delete permissions.
HOME=/srv/simple-file-browser

# Required in the X-Admin-Password header for DELETE requests.
# Leave empty to disable the password check (not recommended).
ADMIN_PASSWORD=admin
