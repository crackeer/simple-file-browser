[Unit]
Description=upload2dir file server (browse / upload / download / delete)
Documentation=https://github.com/crackeer/caddyupload2dir
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Defaults; overridden by /etc/upload2dir.env if present.
Environment=PORT=8080
Environment=HOME=/srv/upload2dir
Environment=ADMIN_PASSWORD=admin
EnvironmentFile=-/etc/upload2dir.env
ExecStart=/usr/local/bin/upload2dir
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
